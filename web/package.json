{
  "name": "local-notes-editor",
  "private": true,
  "scripts": {
    "build": "tsc && node build-assets.mjs",
    "dev:editor": "vite --config vite.editor.config.mjs",
    "build:editor": "tsc -p ../editor/tsconfig.json && vite build --config vite.editor.config.mjs",
    "test:editor": "playwright test -c playwright.editor.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "dompurify": "^3.4.15",
    "leaflet": "^1.9.4",
    "marked": "^18.0.13",
    "turndown": "^7.2.4"
  }
}
